# ============================================================================
# NOVALINK — Environment variables template
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# Public Supabase project values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# SERVER-ONLY. Never expose to the browser. Used only by lib/supabase/admin.ts
# for privileged operations (e.g. admin dashboard role lookups).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct Postgres connection string, used for local migration tooling or psql.
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres

# Public site URL, used for canonical/OG metadata and auth redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.novalink.ca
